        "jsCode": "const users = $input.all().map(item => item.json).filter(u => u && u.id && u.email);\nif (users.length === 0) {\n  console.log('S4: no active Operator users found — digest skipped');\n  return [];\n}\nconsole.log(`S4: processing ${users.length} Operator user(s)`);\nreturn users.map(u => ({ json: { user_id: u.id, email: u.email, plan: u.plan } }));"
